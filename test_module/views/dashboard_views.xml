<odoo>
    <record id="view_test_dashboard_kanban" model="ir.ui.view">
        <field name="name">test_module.dashboard.kanban</field>
        <field name="model">test_module.dashboard</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <field name="name"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_test_dashboard" model="ir.actions.act_window">
        <field name="name">Test Dashboard</field>
        <field name="res_model">test_module.dashboard</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- This is the button: nested inside the existing CRM app menu, not a new app -->
    <menuitem id="menu_test_dashboard_root" name="Test" parent="crm.crm_menu_root"
              action="action_test_dashboard" sequence="15"/>
</odoo>
