<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_ai_lead_wizard_view_form" model="ir.ui.view">
        <field name="name">crm.ai.lead.wizard.form</field>
        <field name="model">crm.ai.lead.wizard</field>
        <field name="arch" type="xml">
            <form string="New Lead AI">
                <header>
                    <button name="action_generate_lead" type="object" string="Generate Lead" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="prompt" nolabel="1" placeholder="e.g. Create a lead for Sarah, she wants to rent an apartment, phone 0612345678, email sarah@example.com"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="crm_ai_lead_wizard_action" model="ir.actions.act_window">
        <field name="name">New Lead AI</field>
        <field name="res_model">crm.ai.lead.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
