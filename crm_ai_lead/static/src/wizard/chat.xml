<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="crm_ai_lead.ChatMessages">
        <div class="o_crm_ai_chat_widget">
            <div class="o_crm_ai_chat" t-ref="chatRoot">
                <t t-if="!messages.length and !state.pendingUser">
                    <div class="o_crm_ai_chat_empty text-muted">
                        Start the conversation below — e.g. "Create a lead for Sarah, she wants to rent an apartment, phone 0612345678, email sarah@example.com".
                    </div>
                </t>
                <t t-foreach="messages" t-as="msg" t-key="msg.id">
                    <div t-attf-class="o_crm_ai_chat_row o_crm_ai_chat_row_{{msg.role}}">
                        <div t-attf-class="o_crm_ai_chat_bubble o_crm_ai_chat_bubble_{{msg.role}}">
                            <span t-esc="msg.content"/>
                        </div>
                    </div>
                </t>
                <t t-if="state.pendingUser">
                    <div class="o_crm_ai_chat_row o_crm_ai_chat_row_user">
                        <div class="o_crm_ai_chat_bubble o_crm_ai_chat_bubble_user">
                            <span t-esc="state.pendingUser"/>
                        </div>
                    </div>
                </t>
                <t t-if="state.isWaiting">
                    <div class="o_crm_ai_chat_row o_crm_ai_chat_row_assistant">
                        <div class="o_crm_ai_chat_bubble o_crm_ai_chat_bubble_assistant o_crm_ai_chat_typing">
                            <span class="o_crm_ai_chat_dot"/>
                            <span class="o_crm_ai_chat_dot"/>
                            <span class="o_crm_ai_chat_dot"/>
                        </div>
                    </div>
                </t>
            </div>
            <div class="o_crm_ai_chat_composer">
                <textarea class="o_crm_ai_chat_input"
                          placeholder="Type a message..."
                          rows="1"
                          t-model="state.text"
                          t-on-keydown="onKeydown"
                          t-att-disabled="state.isWaiting"/>
                <button type="button"
                        class="btn btn-primary o_crm_ai_chat_send"
                        t-on-click="send"
                        t-att-disabled="!canSend">Send</button>
            </div>
        </div>
    </t>

</templates>
